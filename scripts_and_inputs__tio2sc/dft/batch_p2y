#!/bin/bash -x
#SBATCH --job-name="p148"
#SBATCH --time=00:19:59
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --ntasks-per-socket=1
#SBATCH --gpus-per-task=1
##SBATCH --cpus-per-task=32
##SBATCH --account=m3995_g
#SBATCH --account=m3986_g
