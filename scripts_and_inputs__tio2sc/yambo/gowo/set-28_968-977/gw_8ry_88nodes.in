#
HF_and_locXC                     # [R] Hartree-Fock
gw0                              # [R] GW approximation
ppa                              # [R][Xp] Plasmon Pole Approximation for the Screened Interaction
dyson                            # [R] Dyson Equation solver
em1d                             # [R][X] Dynamically Screened Interaction
rim_cut                          # [R][RIM] Coulomb potential
RIM_W                            # [R][RIM] Screened Coulomb potential
NLogCPUs=0                       # [PARALLEL] Live-timing CPU`s (0 for all)
PAR_def_mode= "balanced"         # [PARALLEL] Default distribution mode ("balanced"/"memory"/"workload")
X_and_IO_CPU= "1 1 1 44 8"       # [PARALLEL] CPUs for each role
X_and_IO_ROLEs= "q g k c v"      # [PARALLEL] CPUs roles (q,g,k,c,v)
X_and_IO_nCPU_LinAlg_INV=0       # [PARALLEL] CPUs for Linear Algebra (if -1 it is automatically set)
X_Threads=0                      # [OPENMP/X] Number of threads for response functions
DIP_CPU= "1 44 8"                # [PARALLEL] CPUs for each role
DIP_ROLEs= "k c v"               # [PARALLEL] CPUs roles (k,c,v)
DIP_Threads=0                    # [OPENMP/X] Number of threads for dipoles
SE_CPU= "1 1 1 352"                 # [PARALLEL] CPUs for each role
SE_ROLEs= "q g qp b"             # [PARALLEL] CPUs roles (q,g,qp,b)
SE_Threads=0                     # [OPENMP/GW] Number of threads for self-energy
RandQpts=3000000                 # [RIM] Number of random q-points in the BZ
RandGvec= 103 RL                 # [RIM] Coulomb interaction RS components
RandGvecW= 49 RL                 # [RIM] Screened Coulomb interaction RS components
CUTGeo= "slab z"                 # [CUT] Coulomb Cutoff geometry: box/cylinder/sphere/ws/slab X/Y/Z/XY..
EXXRLvcs= 3572895          RL    # [XX] Exchange    RL components
VXCRLvcs= 3572895          RL    # [XC] XCpotential RL components
Chimod= "HARTREE"                # [X] IP/Hartree/ALDA/LRC/PF/BSfxc
% BndsRnXp
     1 |  5000 |                 # [Xp] Polarization function bands
%
NGsBlkXp= 8                Ry    # [Xp] Response block size
% LongDrXp
 1.0000 | 1.0000 | 0.0000 |      # [Xp] [cc] Electric Field
%
PPAPntXp= 27.21138         eV    # [Xp] PPA imaginary energy
XTermKind= "none"                # [X] X terminator ("none","BG" Bruneval-Gonze)
% GbndRnge
     1 |  5000 |                 # [GW] G[W] bands range
%
GTermKind= "none"                # [GW] GW terminator ("none","BG" Bruneval-Gonze,"BRS" Berger-Reining-Sottile)
DysSolver= "n"                   # [GW] Dyson Equation solver ("n","s","g")
%QPkrange                        # [GW] QP generalized Kpoint/Band indices
1|4|968|977|                     # Full set of states: [718,847]
%

